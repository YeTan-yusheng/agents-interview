# 应用配置
APP_NAME="Agents Interview"
DEBUG=false
# 数据库配置
DATABASE_URL="mysql+pymysql://用户名:密码@主机:端口/agents_interview"
# 日志配置
LOG_LEVEL=INFO
# JWT配置
JWT_SECRET="你的密钥"  """python -c "import secrets; print(secrets.token_hex(32))"""
